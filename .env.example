# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true

# --- Database ----------------------------------------------------------------
# Local (docker compose up db):
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5434/dnd
# Neon — take the connection string from the dashboard and swap the driver to
# postgresql+asyncpg, then drop any ?sslmode=require (asyncpg negotiates TLS itself):
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.eu-central-1.aws.neon.tech/dbname

# --- Security ----------------------------------------------------------------
# Generate one with: python -m app.cli secret
SECRET_KEY=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Cookies -----------------------------------------------------------------
# Must be true in production (HTTPS). Use samesite=none only when the API and
# the frontend are on different sites — and then secure must be true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- URLs / CORS -------------------------------------------------------------
BACKEND_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Google OAuth ------------------------------------------------------------
# https://console.cloud.google.com/apis/credentials → Create OAuth client ID →
# Web application. Add this exact Authorised redirect URI:
#   http://localhost:8001/api/v1/auth/google/callback
# Leave both blank to disable Google sign-in (the endpoints then return 501).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- First account -----------------------------------------------------------
# Used once by: python -m app.cli seed
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme123

# --- AI drafting (optional) --------------------------------------------------
# With no key the feature is simply off and the UI hides it.
OPENAI_API_KEY=
# AI_TEXT_MODEL=gpt-4o-mini
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024
# IMAGE_QUALITY=low
